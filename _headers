# Cloudflare Pages 自訂回應標頭
# 語法：路徑一行（可用 * 萬用字元），底下縮排兩格寫標頭。後面的規則會疊加在前面的規則上。
# ⚠️ 路徑比對「不含查詢字串」，所以 /assets/style.css 這條也會套用到 /assets/style.css?v=16

# ── 全站安全標頭 ──
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# ── 靜態資源快取 ──
# 圖片沒有版號機制，換圖多半是直接覆蓋同檔名，所以只給 30 天，不用 immutable
/assets/*
  Cache-Control: public, max-age=2592000

# 自架字型：檔名固定、靠 ?v=NN 換版，可安全長快取
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# CSS／JS 一律用 ?v=NN 帶版號（改檔案必須升版號，見 進度.md），
# 換版號等於換網址，因此可以安全地開一年 immutable
/assets/style.css
  Cache-Control: public, max-age=31536000, immutable
/assets/landing.css
  Cache-Control: public, max-age=31536000, immutable
/assets/tour.css
  Cache-Control: public, max-age=31536000, immutable
/assets/effects.css
  Cache-Control: public, max-age=31536000, immutable
/assets/main.js
  Cache-Control: public, max-age=31536000, immutable
/assets/landing.js
  Cache-Control: public, max-age=31536000, immutable
/assets/effects.js
  Cache-Control: public, max-age=31536000, immutable
/assets/bot-table.js
  Cache-Control: public, max-age=31536000, immutable

# 這幾支要跟著網站內容更新，不能長快取
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
